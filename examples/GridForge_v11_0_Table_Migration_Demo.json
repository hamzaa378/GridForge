          "B3": "120",
          "C3": "3",
          "A4": "Mar",
          "B4": "95",
          "C4": "5",
          "A5": "Apr",
          "B5": "150",
          "C5": "6",
          "A6": "May",
          "B6": "175",
          "C6": "2",
          "D2": "=[@Revenue]*[@Units]",
          "D3": "=[@Revenue]*[@Units]",
          "D4": "=[@Revenue]*[@Units]",
          "D5": "=[@Revenue]*[@Units]",
          "D6": "=[@Revenue]*[@Units]",
