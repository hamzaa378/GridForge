            {
              "column": 2,
              "values": [
                "3",
                "5"
              ]
            }
          ]
        },
        "conditional": [
          {
            "start": "B2",
            "end": "B7",
            "operator": "scale",
            "threshold": 0,
            "startColor": "#f4fbf6",
            "color": "#2d936b"
          }
